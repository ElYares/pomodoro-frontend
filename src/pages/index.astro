---
import CoffeeCanvas from "../components/CoffeeCanvas.astro";
---

<html>
  <head>
    <title>Pomodoro Pixel</title>
    <link rel="stylesheet" href="/styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=VT323&display=swap" rel="stylesheet">
  </head>

  <body>
    <div id="auth-panel" class="auth-shell">
      <section class="auth-card">
        <div class="auth-copy">
          <span class="eyebrow">Pomodoro Pixel</span>
          <h1>Foco real con trazabilidad real.</h1>
          <p>Crea tu cuenta, sube tareas desde Markdown y deja que cada pomodoro quede guardado.</p>
        </div>

        <div class="auth-box">
          <div class="auth-tabs">
            <button type="button" class="auth-tab active" data-auth-tab="login">Entrar</button>
            <button type="button" class="auth-tab" data-auth-tab="register">Crear cuenta</button>
          </div>

          <p id="auth-message" class="feedback" hidden></p>

          <form id="login-form" data-auth-form="login" class="auth-form">
            <label>
              <span>Email</span>
              <input type="email" name="email" placeholder="tu@email.com" required />
            </label>
            <label>
              <span>Password</span>
              <input type="password" name="password" placeholder="••••••••" required />
            </label>
            <button type="submit" class="primary-button">Iniciar sesion</button>
          </form>

          <form id="register-form" data-auth-form="register" class="auth-form" hidden>
            <label>
              <span>Nombre</span>
              <input type="text" name="name" placeholder="Elya" required />
            </label>
            <label>
              <span>Email</span>
              <input type="email" name="email" placeholder="tu@email.com" required />
            </label>
            <label>
              <span>Password</span>
              <input type="password" name="password" placeholder="Minimo 8 caracteres" required />
            </label>
            <button type="submit" class="primary-button">Crear cuenta</button>
          </form>
        </div>
      </section>
    </div>

    <main id="dashboard" class="dashboard-container" hidden>
      <section class="left-panel">
        <div class="panel-top">
          <div>
            <span class="eyebrow">Pomodoro Pixel</span>
            <h1 class="app-title">Focus Console</h1>
          </div>
          <p id="global-banner" class="feedback" data-tone="muted" hidden></p>
        </div>
        <div class="canvas-container">
          <CoffeeCanvas />
        </div>
      </section>

      <section class="right-panel">
        <div class="tasks-header">
          <div>
            <h2>Mis Tareas</h2>
            <p id="task-status" class="task-status-copy">Importa un Markdown y empieza tu siguiente bloque.</p>
          </div>
          <span id="task-counter" class="counter-badge">0</span>
        </div>

        <div class="user-strip">
          <div>
            <strong id="user-name">Usuario</strong>
            <span id="user-email">email</span>
          </div>
          <button id="logout-button" type="button" class="ghost-button">Salir</button>
        </div>

        <form id="import-form" class="import-card">
          <div>
            <strong>Importar desde Markdown</strong>
            <p>Sube un archivo `.md` con checklist para crear tareas.</p>
          </div>
          <input type="file" name="file" accept=".md,text/markdown" />
          <button type="submit" class="primary-button">Importar tareas</button>
          <p id="import-message" class="feedback" hidden></p>
        </form>
        
        <div id="tasks-root" class="tasks-scroll-area"></div>
      </section>
    </main>

    <script type="module" src="/scripts/tasks-client.js"></script>
    <script type="module" src="/scripts/coffee.js"></script>
  </body>
</html>
